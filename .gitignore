# Dependencies
node_modules/

# Build output — regenerate with `npm run build` / `npm run build:firefox`.
# dist-firefox/ and the packaged zips contain the Firebase web config baked in
# from .env, so they must never be committed.
dist/
dist-firefox/
*.zip

# Local environment — never commit real Firebase config
.env
.env.*
!.env.example
*.local

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Store submission material — kept local, deliberately out of the public source.
# PRIVACY.md carries a personal contact address and still has to be hosted at a
# public URL of its own before either store will accept a submission.
STORE_LISTING.md
PRIVACY.md

# Signing key for the .crx — this IS the extension identity. Never commit.
key.pem
*.pem

# Packaged output
release/
*.crx
