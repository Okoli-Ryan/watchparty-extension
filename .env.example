# Copy this file to `.env` and fill in your Firebase web app config.
# (Project settings → General → Your apps → Web app → SDK setup & config.)
# These are not secrets — access is enforced by Firestore security rules.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=

# Firefox add-on id, used by `npm run build:firefox`. Must be one you control —
# `name@a-domain-you-own` or a UUID in braces. Optional for about:debugging,
# required before submitting to addons.mozilla.org.
WP_GECKO_ID=
