rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myRole() == 'admin';
    }

    // --- users -------------------------------------------------------------
    // Anyone signed in can read profiles (needed for role lookup + owner names).
    // Only admins may create/modify profile docs. NOTE: this gates the profile
    // + role, not the underlying Firebase Auth account. Disable public sign-up
    // in the Firebase console (Auth → Settings) so accounts can only originate
    // from the admin flow.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      // Each user's own room history + favourites. Rules do not cascade into
      // subcollections, so this needs its own match: the profile stays
      // admin-only while the user manages their own history.
      match /history/{roomId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // --- rooms -------------------------------------------------------------
    match /rooms/{roomId} {
      allow read: if signedIn();
      // Any signed-in user may create a room (they become the owner).
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Updates: the current owner may change anything (playback, handoff to a
      // new owner, deactivation). A non-owner may only perform an ownership
      // handoff to themselves (used when the previous owner has gone stale).
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || request.resource.data.ownerUid == request.auth.uid
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // --- chat -------------------------------------------------------------
      // Bodies are AES-GCM ciphertext written by the client, so these documents
      // never contain readable message text. A message is immutable once sent:
      // only its author may create it, and nobody may edit it afterwards.
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.ct is string
          && request.resource.data.iv is string;
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.senderUid == request.auth.uid
          || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
        );
      }

      // --- members (presence) ---------------------------------------------
      // Each member manages only their own membership/heartbeat doc; the room
      // owner may prune anyone (delete stale members).
      match /members/{memberUid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == memberUid;
        allow delete: if signedIn() && (
          request.auth.uid == memberUid
          || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid
        );
      }
    }
  }
}
